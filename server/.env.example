PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/portfolio?retryWrites=true&w=majority
# Exact browser origins allowed to perform admin writes (no wildcard).
ADMIN_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Set NODE_ENV=production on HTTPS deployments for Secure session cookies.

# Optional: use only when the local DNS resolver cannot resolve Atlas SRV records.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
